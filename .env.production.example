# Variabel lingkungan untuk server game (dipakai PM2 / VPS).
# Salin ke .env.production di root proyek bila ingin meng-override nilai default.
# Untuk Koyeb: JANGAN salin file ini. Koyeb men-set PORT otomatis dan HOST harus 0.0.0.0.
NODE_ENV=production
PORT=2567
HOST=127.0.0.1

# Opsional: lokasi build client bila struktur folder berbeda.
# CLIENT_DIST=/var/www/perang-petasan/client/dist
